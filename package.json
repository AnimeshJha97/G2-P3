{
  "name": "novelty-scoring-system",
  "version": "0.1.0",
  "private": true,
  "description": "An explainable novelty-scoring system for structured submissions.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "evaluate": "tsx src/evaluation/run.ts",
    "prescore": "tsc --project tsconfig.score.json",
    "score": "node .tmp/score-cli/cli/score.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "dotenv": "^18.0.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
